{
  "name": "upnext",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "main.cjs",
  "description": "An always-on-top, minimalist to-do app that keeps tasks visible so you capture and finish work faster.",
  "author": "Abhishek Ingle (Abhishekingle662)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Abhishekingle662/UpNext.git"
  },
  "homepage": "https://github.com/Abhishekingle662/UpNext",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "publish": "electron-builder --publish=always",
    "zip-dist": "npm run pack && node create-zip-dist.cjs",
    "version:patch": "node increment-version.cjs patch",
    "version:minor": "node increment-version.cjs minor",
    "version:major": "node increment-version.cjs major",
    "release": "npm run version:patch && npm run zip-dist",
    "serve-web": "node serve-web.js",
    "setup": "node setup.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "firebase": "^10.7.1"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.2",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.abhi.upnext",
    "productName": "UpNext",
    "asar": true,
    "files": [
      "main.cjs",
      "firebase-main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "package.json",
      "assets/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Abhishekingle662",
      "repo": "UpNext"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "assets/icon.ico",
      "publisherName": [
        "Abhishek Ingle"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UpNext"
    }
  }
}
